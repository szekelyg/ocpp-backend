# Másold ".env"-re az új szerveren és töltsd ki az ÉLES értékekkel.
# A legegyszerűbb: a Raspiról a /etc/ocpp-backend.env tartalmát emeld át ide
# (sudo cat /etc/ocpp-backend.env), és csak a DATABASE_URL-t igazítsd a lentihez.
#
# FIGYELEM: éles Stripe kulcsok vannak benne – ezt a fájlt SOHA ne commitold gitbe.

# --- Adatbázis ---
# A) helyi Postgres konténer (alapértelmezett). A jelszó EGYEZZEN a POSTGRES_PASSWORD-del.
POSTGRES_PASSWORD=valami_eros_jelszo
DATABASE_URL=postgresql+asyncpg://ocppuser:valami_eros_jelszo@db:5432/ocpp
# B) Neon (külső): kommenteld ki a fenti DATABASE_URL-t és használd ezt a formát:
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/ocpp?ssl=require

# --- Publikus URL (Stripe redirect, számlák, QR linkek) ---
PUBLIC_BASE_URL=https://ev.energiafelho.hu

# --- Árazás ---
OCPP_PRICE_HUF_PER_KWH=170
# Üzleti minimum (HUF). FIGYELEM: a Stripe technikai HUF-minimuma ~175 Ft – ez alatti
# capture-t a Stripe elutasít, ezért élesben ne állítsd 175 alá, ha terhelni is akarsz.
# (Teszteléshez ideiglenesen lehet alacsonyabb, de akkor a tényleges levonás elbukhat.)
STRIPE_MIN_HUF=500
OCPP_DISPLAY_TEXT=A töltés megkezdéséhez olvassa be a QR kódot

# --- Admin (fail-closed: enélkül az admin végpontok 503-at adnak) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=valami_eros_admin_jelszo

# --- Stripe (ÉLES kulcsok) ---
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Resend (email küldés) ---
RESEND_API_KEY=re_...
RESEND_FROM=szerviz@energiafelho.hu

# --- Számlázz.hu ---
SZAMLAZZ_AGENT_KEY=...
SZAMLAZZ_INVOICE_PREFIX=EV
SZAMLAZZ_BANK_NAME=...
SZAMLAZZ_BANK_ACCOUNT=...
SZAMLAZZ_REPLY_EMAIL=szerviz@energiafelho.hu

# --- OCPI 2.2.1 (CPO szerep) ---
# Fail-closed: OCPI csak akkor él, ha OCPI_ENABLED=true ÉS OCPI_TOKEN_A be van állítva.
# Enélkül az /ocpi végpontok 503-at adnak (a saját identitás-konfiguráció hiányában).
OCPI_ENABLED=false
OCPI_COUNTRY_CODE=HU
OCPI_PARTY_ID=ENF
OCPI_BUSINESS_NAME=Energiafelhő Kft.
OCPI_BUSINESS_WEBSITE=https://energiafelho.hu
# OCPI_BUSINESS_LOGO_URL=https://ev.energiafelho.hu/logo.png
OCPI_TIME_ZONE=Europe/Budapest
# Token A: előre megosztott regisztrációs titok (a partner ezzel indítja a handshake-et).
# Generálj egy hosszú véletlent: python -c "import secrets; print(secrets.token_urlsafe(32))"
OCPI_TOKEN_A=
# OCPI_BASE_URL alapból a PUBLIC_BASE_URL-t használja; csak akkor állítsd, ha eltér.
# OCPI_BASE_URL=https://ev.energiafelho.hu
# Ha egy location address_text-je nem parse-olható, ez lesz a város az OCPI Location-ben:
# OCPI_DEFAULT_CITY=Budapest

# --- Egységes Energiafelhő-fiók (Keycloak) – lásd docs/KEYCLOAK.md ---
# Fail-closed: KEYCLOAK_ISSUER nélkül a Keycloak-tokenek 401-et kapnak és a SPA-ban nincs
# "Belépés Energiafelhő-fiókkal" gomb (ez az egyetlen fiókos belépés); a vendég-út ettől független.
KEYCLOAK_ISSUER=https://id.energiafelho.hu/realms/ugyfelek
# Az `aud`-ban elvárt kliens (a SPA public kliense). Az ilyen azp-jű token mindig elfogadott.
KEYCLOAK_AUDIENCE=ev
# További saját kliensek (vesszővel), amelyek tokenjét aud nélkül, azp alapján elfogadjuk – a portál.
KEYCLOAK_ALLOWED_AZP=portal
# KEYCLOAK_JWKS_URL=            # alapból {issuer}/protocol/openid-connect/certs
# KEYCLOAK_JWKS_TTL_S=3600
# KEYCLOAK_SPA_CLIENT_ID=ev     # ha a SPA kliens-ID-ja eltérne a KEYCLOAK_AUDIENCE-től
# CORS a /api/me/* útvonalon (Bearer, cookie nélkül) – a portál originje(i), vesszővel.
# PORTAL_ORIGINS=https://my.energiafelho.hu
